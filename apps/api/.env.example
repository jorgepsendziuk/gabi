PORT=4000
NODE_ENV=development

# Meta GABI — Supabase (recomendado). Ver scripts/supabase/03_env_exemplo.md
# Gere apps/api/.env.local com: ./scripts/supabase/configure-api-env.sh 'SENHA_POSTGRES'
# Ou use usuário gabi_api (criado no deploy): DB_USER=gabi_api.SEU_REF
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=gabi_api.gjtgxnmodzsnnqosxpgl
DB_PASSWORD=defina-no-env-local
DB_SSL=true

# Local Docker (alternativa dev)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gabi
# DB_USER=gabi
# DB_PASSWORD=gabi
# DB_SSL=false

CONNECTION_SECRET=change-me-connection-encryption

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=admin@gabi.local
ADMIN_PASSWORD=admin123

CORS_ORIGIN=http://localhost:5173
